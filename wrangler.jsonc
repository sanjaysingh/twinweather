{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "twinweather",
  "account_id": "762ce683f0c51592bb1480f5fd3e7b7e",
  "main": "src/index.ts",
  "workers_dev": false,
  "routes": [
    {
      // Query strings only match a pattern that ends in *. The share card
      // reads ?l= on the page itself, then proxies other files onward.
      "pattern": "twinweather.sanjaysingh.net/*",
      "zone_id": "0cf0b9c4853d3580457fd97e4081d5d9"
    }
  ],
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": true
    }
  ],
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
